{
  "name": "dy-mcp-demo",
  "version": "0.1.0",
  "description": "Public, unauthenticated demo of dy-mcp — an MCP personal-context server. Resets hourly. Source: https://github.com/dyuhaus/dy-mcp",
  "type": "module",
  "bin": {
    "dy-mcp-demo": "dist/index.js",
    "dy-mcp-demo-api": "dist/server.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:api": "node dist/server.js",
    "dev": "tsx src/index.ts",
    "dev:api": "tsx src/server.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web run test",
    "web:lint": "npm --prefix web run lint",
    "test:all": "npm test && npm --prefix web test",
    "lint:all": "npm run lint && npm --prefix web run lint",
    "typecheck:all": "npm run typecheck && npm --prefix web run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.5.0",
    "ignore": "^6.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
