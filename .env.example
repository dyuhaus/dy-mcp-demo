# ──────────────────────────────────────────────────────────────────────
# dy-mcp-demo — public demo server (no auth, hourly reset)
# ──────────────────────────────────────────────────────────────────────

# SQLite database path. The demo reset script wipes and reseeds this DB
# every hour. Default: ~/.dy-mcp-demo/context.db
# DY_MCP_DB_PATH=/absolute/path/to/demo.db

# Port for the HTTP API. Default: 7879 (keeps it off 7878 in case the main
# dy-mcp server runs on the same machine).
# DY_MCP_API_PORT=7879

# How often (in minutes) the seed script is scheduled to run. This is purely
# informational — the actual reset cadence is set by your Task Scheduler or
# cron entry. The /health endpoint reports this value so the UI can tell
# visitors how stale the current data might be. Default: 60.
# DY_MCP_DEMO_RESET_MIN=60

# Absolute path to the built web app. Defaults to <repo>/web/dist. The HTTP
# server serves these files so one hostname covers both UI and API.
# DY_MCP_WEB_DIST=

# CORS Access-Control-Allow-Origin for the API. Default: *
# DY_MCP_API_ORIGIN=*

# ──────────────────────────────────────────────────────────────────────
# web/ — Vite frontend
# Put these in web/.env.local (VITE_-prefixed so Vite exposes them).
# ──────────────────────────────────────────────────────────────────────

# API base URL. Leave unset for same-origin (recommended — UI + API share
# the same hostname behind the tunnel).
# VITE_API_BASE_URL=http://localhost:7879
